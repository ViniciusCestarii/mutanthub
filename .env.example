# ---------------------------------------------------------------------------
# MutantHub environment
# Copy this file to .env and adjust the values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (see README for a docker one-liner)
DATABASE_URL="postgresql://mutanthub:mutanthub@localhost:5432/mutanthub?schema=public"

# Auth.js secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the app. Optional in development (the request host is trusted);
# set it in production or behind a proxy, e.g. https://mutanthub.example.com
# AUTH_URL="http://localhost:3000"

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
# Leave both empty to use the mocked login (sign in as any seed user).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Force the mocked login even when GitHub OAuth is configured (dev/test only).
# Never enable this in production.
AUTH_MOCK="false"

# GitHub API access for repository browsing.
# A fine-grained or classic token with *public repository read* access is enough.
GITHUB_TOKEN=""

# auto  -> live GitHub API when GITHUB_TOKEN is set, otherwise bundled fixtures
# live  -> always call the GitHub API (unauthenticated calls are limited to 60/hour)
# mock  -> always use the bundled fixture repositories (bitcoin/bitcoin, curl/curl, llvm/llvm-project)
GITHUB_MODE="auto"

# Cache TTL (seconds) for GitHub API responses kept in memory
GITHUB_CACHE_TTL="300"

# Optional shared Redis for rate limiting and the GitHub cache. Leave empty for a
# single instance (in-memory stores). Required when running several app instances.
REDIS_URL=""

# --- GitHub App (optional, recommended for real deployments) --------------------
# Create an app at GitHub -> Settings -> Developer settings -> GitHub Apps with
# repository permissions Contents: Read-only and Metadata: Read-only, subscribe to
# the "Installation" events, and point the webhook at <AUTH_URL>/api/github/webhook.
# When configured, repositories where the app is installed are read with
# installation tokens (5,000 requests/hour each); others fall back to GITHUB_TOKEN.
GITHUB_APP_ID=""
# PEM private key. Either paste it with literal "\n" line breaks or base64-encode it.
GITHUB_APP_PRIVATE_KEY=""
# The app's URL slug (github.com/apps/<slug>), used for "Install" links.
GITHUB_APP_SLUG=""
GITHUB_APP_WEBHOOK_SECRET=""
